<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the launcher's Settings sheet (tvos_style): icon, name, value on the right and a chevron when it
     leads to a page. White when focused, like the rest of the glass. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="16sp"
        android:fontFamily="@string/font_medium"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="190dp"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="13sp"
        android:fontFamily="@string/font_regular"
        android:singleLine="true"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron"
        android:tint="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:contentDescription="@null" />
</LinearLayout>
